{
  "$schema": "../../ui/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Audio Leveller",
  "identifier": "com.ninoan.audioleveller",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist/audio-leveller"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Audio Leveller",
        "width": 760,
        "height": 900,
        "minWidth": 560,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundColor": "#c3c3c3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "copyright": "MIT licensed. Everything runs on your machine; nothing is uploaded.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "../../build/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "wav"
        ],
        "name": "WAV audio",
        "role": "Viewer",
        "mimeType": "audio/wav"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
