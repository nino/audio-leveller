{
  "name": "audio-leveller",
  "version": "0.1.0",
  "description": "Levelator-style drag-and-drop loudness leveller. Normalizes each speech segment of a WAV file to -23 LUFS with smooth gain ramps across silences.",
  "author": "Nino Annighoefer",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "pnpm build && electron .",
    "dev": "pnpm build && electron .",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reaper": "lua reaper/test_dsp.lua",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "pnpm build && electron-builder",
    "eval": "pnpm build && node dist/eval/run.js",
    "fetch-model": "pnpm build && node scripts/fetch-model.mjs",
    "listen": "vite --config listen/vite.config.ts",
    "listen:session": "pnpm build && node dist/listen/build-session.js",
    "listen:typecheck": "tsc -p listen/tsconfig.json --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "onnxruntime-node"
    ]
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.ninoan.audioleveller",
    "productName": "Audio Leveller",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    }
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.27.0"
  }
}
